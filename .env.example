# Copy to .env. Never commit .env or paste keys in chat.
X_BEARER_TOKEN=
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint + model override.
# Leave empty for OpenAI default (https://api.openai.com/v1 + gpt-5.4-mini).
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-5.4-mini
# Public origin(s) allowed to POST to the API when behind a reverse proxy
# (comma-separated, no trailing slash). Required for proxied deployments.
ORBIT_PUBLIC_ORIGINS=https://x.lokarayaspace.com
# First-admin setup only. Generate locally, e.g. openssl rand -hex 32.
# Remove this token after setup; never share it or commit .env.
ORBIT_SETUP_TOKEN=
